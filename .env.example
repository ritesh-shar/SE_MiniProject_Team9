# Django settings — copy this file to .env and edit as needed.
# NEVER commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database: defaults to SQLite if these are not set.
# Uncomment and fill in for PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bbms
# DB_USER=bbms_user
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432
